# Global Reefers API (the DecoFrut report only accepts HTTP Basic auth)
URL = https://api.globalreefers.app/
USERNAME = ''
PASSWORD = ''

# Data base URL
DATABASE_URL = postgresql://postgres:password@localhost:5432/scraper-chile

# Table with the comparable records (the one the ETL reads)
RECORDS_TABLE = records

# Table with the raw rows of the last response per scope (defaults to
# <RECORDS_TABLE>_original when left out)
HISTORY_TABLE = records_original

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL = INFO

# Email notifications (only sent with --email)
MAILCHIMP_API_KEY = ''
FROM_NAME = Agronometrics Chile Scraper
FROM_EMAIL = ''
TO_EMAIL = ''
